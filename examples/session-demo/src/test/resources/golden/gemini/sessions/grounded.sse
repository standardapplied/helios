data: {"index":3,"delta":{"text":"The capital of Australia is **Canberra**","type":"text"},"event_type":"step.delta"}

event: step.delta
data: {"index":3,"delta":{"text":".\n\n### Official Population Figures\n\nAccording to the **Australian Bureau of Statistics (ABS)**:\n\n*","type":"text"},"event_type":"step.delta"}

event: step.delta
data: {"index":3,"delta":{"text":" **Greater Capital City (Canberra / Australian Capital Territory):** As of **June 30, 2025**,","type":"text"},"event_type":"step.delta"}

event: step.delta
data: {"index":3,"delta":{"text":" the official Estimated Resident Population (ERP) for Canberra was **484,630**, representing an annual increase of approximately","type":"text"},"event_type":"step.delta"}

event: step.delta
data: {"index":3,"delta":{"text":" 1.3%.\n* **Canberra–Que","type":"text"},"event_type":"step.delta"}

event: step.delta
data: {"index":3,"delta":{"text":"anbeyan Significant Urban Area:** When including the adjacent urban area of Queanbeyan across the New South Wales border, the combined","type":"text"},"event_type":"step.delta"}

event: step.delta
data: {"index":3,"delta":{"text":" population stood at **521,049** as of June 30, 2025","type":"text"},"event_type":"step.delta"}

event: step.delta
data: {"index":3,"delta":{"text":".\n* **Census Count (Historical Baseline):** At the most recent comprehensive census (","type":"text"},"event_type":"step.delta"}

event: step.delta
data: {"index":3,"delta":{"text":"August 2021), the usual resident population counted for the ACT/Canberra was approximately **454,","type":"text"},"event_type":"step.delta"}

event: step.delta
data: {"index":3,"delta":{"text":"000**.\n\n***\n\n**Sources:**\n*","type":"text"},"event_type":"step.delta"}

