event: step.delta
data: {"index":5,"delta":{"text":"The capital of Australia is **Canberra**","type":"text"},"event_type":"step.delta"}

event: step.delta
data: {"index":5,"delta":{"text":". \n\n### Approximate Population\nAccording to the latest **Australian Bureau of Statistics (ABS)** data released in March 2","type":"text"},"event_type":"step.delta"}

event: step.delta
data: {"index":5,"delta":{"text":"026:\n* As of June 30, 2","type":"text"},"event_type":"step.delta"}

event: step.delta
data: {"index":5,"delta":{"text":"025, Canberra's Estimated Resident Population (ERP) was **484,630**","type":"text"},"event_type":"step.delta"}

event: step.delta
data: {"index":5,"delta":{"text":".\n* With an annual growth rate of roughly 1.3%,","type":"text"},"event_type":"step.delta"}

event: step.delta
data: {"index":5,"delta":{"text":" the population is projected to surpass **490,000** during 2026.","type":"text"},"event_type":"step.delta"}

event: step.delta
data: {"index":5,"delta":{"text":"\n\n*(Note: The ABS and local demographers typically use the population of the entire Australian Capital Territory (ACT) as the","type":"text"},"event_type":"step.delta"}

event: step.delta
data: {"index":5,"delta":{"text":" representative figure for Canberra, as over 99% of ACT residents live within the Canberra urban area","type":"text"},"event_type":"step.delta"}

event: step.delta
data: {"index":5,"delta":{"text":".)*","type":"text"},"event_type":"step.delta"}

