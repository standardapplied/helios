<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.standardapplied</groupId>
    <artifactId>helios</artifactId>
    <version>3.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>helios</name>
    <description>Production-grade agentic framework for Java</description>
    <url>https://github.com/standardapplied/helios</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Standard Applied Intelligence Labs</name>
            <organization>Standard Applied Intelligence Labs</organization>
            <organizationUrl>https://standardapplied.com</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/standardapplied/helios.git</connection>
        <developerConnection>scm:git:ssh://github.com:standardapplied/helios.git</developerConnection>
        <url>https://github.com/standardapplied/helios</url>
    </scm>

    <properties>
        <junit-version>6.0.2</junit-version>
        <jackson-tools-version>3.0.4</jackson-tools-version>
        <jackson-old-version>2.18.2</jackson-old-version>
        <helidon-version>4.4.1</helidon-version>
        <testcontainers-version>1.21.4</testcontainers-version>
        <postgresql-driver-version>42.7.12</postgresql-driver-version>
        <maven-pmd-plugin-version>3.28.0</maven-pmd-plugin-version>
        <pmd-version>7.28.0</pmd-version>
        <archunit-version>1.5.1</archunit-version>

        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <helios.test.native-access>ALL-UNNAMED</helios.test.native-access>
        <helios.quality.config>${maven.multiModuleProjectDirectory}/config/quality</helios.quality.config>
    </properties>

    <modules>
        <module>core</module>
        <module>session</module>
        <module>runtime</module>
        <module>gemini</module>
        <module>anthropic</module>
        <module>openai</module>
        <module>persistence</module>
        <module>onnx</module>
        <module>repl</module>
        <module>testing</module>
        <module>architecture</module>
        <module>examples/codeact-demo</module>
        <module>examples/rlm-demo</module>
        <module>examples/session-demo</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit-version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <!--
                  Pin maven-javadoc-plugin so `mvn javadoc:jar` (run by CI) matches local. Without
                  this, Maven resolves the latest plugin version from Central and local/CI can
                  drift — the 1.4 CI cut surfaced this when 3.12.0 picked up a doclint warning
                  3.11.x ignored.
                -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <argLine>
                        @{argLine}
                        -Duser.timezone=UTC
                        --enable-native-access=${helios.test.native-access}
                        --add-opens java.base/java.util=ALL-UNNAMED
                        --add-opens java.base/java.lang=ALL-UNNAMED
                    </argLine>
                    <!--
                      Turns a deadlocked test into a failure instead of a hung CI job. It is not
                      a wait limit: a test waits through core.test.Await, whose hang guard fails
                      it long before this.
                    -->
                    <properties>
                        <configurationParameters>junit.jupiter.execution.timeout.default = 10 m</configurationParameters>
                    </properties>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-libs</id>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>3.2.1</version>
                <configuration>
                    <java>
                        <googleJavaFormat>
                            <version>1.27.0</version>
                            <style>GOOGLE</style>
                        </googleJavaFormat>
                        <importOrder>
                            <order>\#,</order>
                        </importOrder>
                        <removeUnusedImports>
                            <engine>cleanthat-javaparser-unnecessaryimport</engine>
                        </removeUnusedImports>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!--
                  Quality gate, documented in CLAUDE.md. `check` and `aggregate-cpd-check` fork
                  their own main-code analysis that reads only this plugin-level configuration,
                  so the main rule set, the PMD exclusions and the shared settings live here; the
                  test-code PMD analysis and the main-and-test CPD analysis are the explicit
                  executions below, each followed by a check pointed at its output directory.
                  The analysis goals apply the exclusion file too, so both CPD executions name
                  the CPD file: read as CPD exclusions, the blank lines of the PMD properties
                  file would silence every duplication inside a single file.
                -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>${maven-pmd-plugin-version}</version>
                <dependencies>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-core</artifactId>
                        <version>${pmd-version}</version>
                    </dependency>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-java</artifactId>
                        <version>${pmd-version}</version>
                    </dependency>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-javascript</artifactId>
                        <version>${pmd-version}</version>
                    </dependency>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-jsp</artifactId>
                        <version>${pmd-version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <rulesets>
                        <ruleset>${helios.quality.config}/pmd-main.xml</ruleset>
                    </rulesets>
                    <excludeFromFailureFile>${helios.quality.config}/pmd-exclusions.properties</excludeFromFailureFile>
                    <targetJdk>${maven.compiler.release}</targetJdk>
                    <skipPmdError>false</skipPmdError>
                    <printFailingErrors>true</printFailingErrors>
                    <analysisCache>true</analysisCache>
                    <linkXRef>false</linkXRef>
                    <minimumTokens>100</minimumTokens>
                </configuration>
                <executions>
                    <execution>
                        <id>pmd-main-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>pmd-test</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>pmd</goal>
                        </goals>
                        <configuration>
                            <includeTests>true</includeTests>
                            <excludeRoots>
                                <excludeRoot>${project.build.sourceDirectory}</excludeRoot>
                            </excludeRoots>
                            <rulesets>
                                <ruleset>${helios.quality.config}/pmd-test.xml</ruleset>
                            </rulesets>
                            <targetDirectory>${project.build.directory}/pmd-test</targetDirectory>
                            <analysisCacheLocation>${project.build.directory}/pmd-test/pmd.cache</analysisCacheLocation>
                        </configuration>
                    </execution>
                    <execution>
                        <id>pmd-test-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <targetDirectory>${project.build.directory}/pmd-test</targetDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>cpd</id>
                        <phase>verify</phase>
                        <inherited>false</inherited>
                        <goals>
                            <goal>aggregate-cpd</goal>
                        </goals>
                        <configuration>
                            <includeTests>true</includeTests>
                            <targetDirectory>${project.build.directory}/cpd</targetDirectory>
                            <excludeFromFailureFile>${helios.quality.config}/cpd-exclusions.txt</excludeFromFailureFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>cpd-check</id>
                        <inherited>false</inherited>
                        <goals>
                            <goal>aggregate-cpd-check</goal>
                        </goals>
                        <configuration>
                            <targetDirectory>${project.build.directory}/cpd</targetDirectory>
                            <excludeFromFailureFile>${helios.quality.config}/cpd-exclusions.txt</excludeFromFailureFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.14</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.12.0</version>
                        <configuration>
                            <linksource>true</linksource>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <deploymentName>helios-${project.version}</deploymentName>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>flatten-maven-plugin</artifactId>
                        <version>1.7.3</version>
                        <configuration>
                            <flattenMode>ossrh</flattenMode>
                        </configuration>
                        <executions>
                            <execution>
                                <id>flatten</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>flatten</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>flatten-clean</id>
                                <phase>clean</phase>
                                <goals>
                                    <goal>clean</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
